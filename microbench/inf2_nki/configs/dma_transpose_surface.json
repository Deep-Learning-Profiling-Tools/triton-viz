{
  "suite": "inf2_nki_dma_transpose_surface",
  "description": "HBM[f,p] to SBUF[p,f] DMA-transpose surface, directly comparable with the copy surface.",
  "warmup": 10,
  "iters": 100,
  "benchmarks": [
    {
      "name": "dma_transpose_surface",
      "kind": "dma_transpose",
      "repeat": 1,
      "modes": ["hbm_to_sbuf_transpose"],
      "matrix": {
        "dtype": ["float32", "bfloat16"],
        "p": [1, 2, 4, 6, 8, 9, 12, 16, 32, 64, 128],
        "f": [32, 64, 128, 256, 384, 512, 768, 1024]
      }
    }
  ]
}
