      %v_5 = tt.load %v_4 : tensor<64x!tt.ptr<f32>> loc(#loc26)
      %2 = tt.splat %out_ptr : !tt.ptr<f32> -> tensor<64x!tt.ptr<f32>> loc(#loc13)
